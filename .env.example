# Copiar a .env y completar valores. No versionar .env con secretos reales.
# docker compose lee automáticamente el archivo .env de esta carpeta.

# --- Backend (FastAPI) → Supabase externo ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
ML_SERVICE_URL=
FRONTEND_ORIGIN=http://localhost
APP_ENV=production
INVITE_EXPIRY_HOURS=72
INVITE_BASE_URL=http://localhost/activate-account
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend (Next.js) — se inyectan en el BUILD de la imagen ---
# Dejar NEXT_PUBLIC_API_URL vacío para usar rutas relativas /api/v1/...
# detrás de Nginx (mismo origen). No usar http://localhost:8000 en Docker.
# No usar /api como valor: las rutas del cliente ya incluyen el prefijo /api.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
